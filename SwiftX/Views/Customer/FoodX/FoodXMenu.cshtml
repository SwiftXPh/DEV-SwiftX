@{
    ViewData["Title"] = "Store Menu";
    Layout = "~/Views/Shared/_LayoutCustomerSubPage.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/user/FoodX/FoodXMenu.css" asp-append-version="true" />
}

<div class="fxm-page">

    @* ── Hero banner ── *@
    <div class="fxm-hero">
        <img src="https://images.unsplash.com/photo-1555396273-367ea4eb4db5?q=80&w=800"
             alt="Restaurant banner" class="fxm-hero__img" id="fxm-banner-img"
             onerror="this.src='https://images.unsplash.com/photo-1555396273-367ea4eb4db5?q=80&w=800'">

        <div class="fxm-hero__nav">
            <button type="button" class="fxm-icon-btn" id="fxmBackBtn" aria-label="Go back">
                <i class="ph ph-arrow-left"></i>
            </button>
            <button type="button" class="fxm-icon-btn" id="fxmCartBtn" aria-label="View cart">
                <i class="ph ph-shopping-cart"></i>
                <span class="fxm-cart-badge" id="cart-count"></span>
            </button>
        </div>

        <div class="fxm-hero__logo">
            <img src="https://via.placeholder.com/55" alt="Store logo" id="fxm-logo-img"
                 onerror="this.src='https://via.placeholder.com/55'">
        </div>
    </div>

    @* ── Store info ── *@
    <div class="fxm-store-info">
        <h2 class="fxm-store-info__name" id="fxm-store-name">Loading store...</h2>
        <p class="fxm-store-info__meta" id="fxm-store-meta"></p>
    </div>

    @* ── Category tabs — populated dynamically by JS ── *@
    <div class="fxm-tabs" id="fxm-tabs"></div>

    @* ── Menu list — populated dynamically by JS ── *@
    <div class="fxm-menu" id="menu-list"></div>

</div>

@section PageScripts {
    <script src="~/js/user/FoodX/FoodXMenu.js" asp-append-version="true"></script>
}
