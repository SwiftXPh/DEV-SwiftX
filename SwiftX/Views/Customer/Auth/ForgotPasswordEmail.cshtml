@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_LayoutCustomerLogin.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/user/auth/forgot-password.css" asp-append-version="true" />
}


<div class="fp-page">

    <header class="fp-header">
        <button type="button" class="fp-back-btn" id="fpBackBtn" aria-label="Go back">
            <i class="ph ph-arrow-left"></i>
        </button>
        <h1 class="fp-header__title">Forgot Password</h1>
    </header>

    <main class="fp-body">
        <div class="fp-card">

            <form id="emailForm" novalidate>

                <div class="fp-field">
                    <label for="emailInput">Email Address</label>
                    <input type="email" id="emailInput" name="Email"
                           placeholder="yourname@email.com"
                           autocomplete="email" required>
                </div>

                <button type="submit" class="fp-btn">Next</button>

            </form>

        </div>
    </main>

</div>

@await Html.PartialAsync("_ModalAlert")

@section PageScripts {
    <script src="~/js/user/auth/forgot-email.js" asp-append-version="true"></script>
    <script src="~/js/modal.js" asp-append-version="true"></script>
    <script src="~/js/modal-alert.js" asp-append-version="true"></script>
}
