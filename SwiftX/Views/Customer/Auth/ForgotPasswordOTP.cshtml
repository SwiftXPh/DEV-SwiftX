@{
    ViewData["Title"] = "Verify Email";
    Layout = "~/Views/Shared/_LayoutCustomerLogin.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/user/auth/forgot-password.css" asp-append-version="true" />
}

<div class="fp-page">

    <header class="fp-header">
        <button type="button" class="fp-back-btn" id="fpBackBtn" aria-label="Go back">
            <i class="ph ph-arrow-left"></i>
        </button>
        <h1 class="fp-header__title">Verify Email</h1>
    </header>

    <main class="fp-body">
        <div class="fp-card">

            <h2 class="fp-card__subtitle">Enter Your 6-Digit OTP</h2>

            <form id="verifyForm" novalidate>

                <div class="fp-field">
                    <label for="otpInput">OTP Code</label>
                    <input type="text" id="otpInput" name="OTP"
                           maxlength="6" pattern="[0-9]*"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           required>
                </div>

                <div class="fp-otp-meta">
                    <p class="fp-status-msg" id="otpStatusMsg">A code was sent to your email.</p>
                    <button type="button" class="fp-resend-btn" id="resendBtn">Resend</button>
                </div>

                <button type="submit" class="fp-btn">Verify</button>

            </form>

        </div>
    </main>

</div>

@await Html.PartialAsync("_ModalAlert")

@section PageScripts {
    <script src="~/js/user/auth/forgot-otp.js" asp-append-version="true"></script>
    <script src="~/js/modal.js" asp-append-version="true"></script>
    <script src="~/js/modal-alert.js" asp-append-version="true"></script>
}
