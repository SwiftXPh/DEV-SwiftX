@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_LayoutCustomerLogin.cshtml";
}

@section Styles {
    @* Reuses the shared forgot-password.css — same header/field/button pattern *@
    <link rel="stylesheet" href="~/css/user/auth/forgot-password.css" asp-append-version="true" />
}

<div class="fp-page">

    <header class="fp-header">
        <button type="button" class="fp-back-btn" id="cpBackBtn" aria-label="Go back">
            <i class="ph ph-arrow-left"></i>
        </button>
        <h1 class="fp-header__title">Change Password</h1>
    </header>

    <main class="fp-body">
        <div class="fp-card">

            <form id="passwordForm" novalidate>

                <div class="fp-field">
                    <label for="newPassword">New Password</label>
                    <div class="fp-field__pw-wrap">
                        <input type="password" id="newPassword" name="NewPassword"
                               autocomplete="new-password" required>
                        <button type="button" class="fp-field__toggle"
                                onclick="togglePassword('newPassword', this)"
                                aria-label="Toggle password visibility">
                            <i class="ph ph-eye-slash"></i>
                        </button>
                    </div>
                </div>

                <div class="fp-field">
                    <label for="confirmPassword">Confirm New Password</label>
                    <div class="fp-field__pw-wrap">
                        <input type="password" id="confirmPassword" name="ConfirmPassword"
                               autocomplete="new-password" required>
                        <button type="button" class="fp-field__toggle"
                                onclick="togglePassword('confirmPassword', this)"
                                aria-label="Toggle confirm password visibility">
                            <i class="ph ph-eye-slash"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="fp-btn">Save Password</button>

            </form>

        </div>
    </main>

</div>

@await Html.PartialAsync("_ModalAlert")

@section PageScripts {
    <script src="~/js/modal.js"              asp-append-version="true"></script>
    <script src="~/js/modal-alert.js"        asp-append-version="true"></script>
    <script src="~/js/user/auth/change-password.js" asp-append-version="true"></script>
}
