@model SwiftX.Models.CustomerHomeViewModel

@{
    ViewData["Title"] = "Customer Home";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/user/Home/CustomerHome.css" asp-append-version="true" />
}

<!-- SIDEBAR SETTINGS -->
<div id="sideMenu" class="sidebar">
    <div class="menu-overlay" onclick="toggleMenu()"></div>

    <div class="sidebar-content">
        <button class="close-btn" onclick="toggleMenu()">&times;</button>

        <div class="user-profile">
            <img class="profile-pic"
                 src="/images/default-profile.png"
                 alt="Profile">
            <div class="user-info">
                <h3 id="sidebarUserName">@Model.FullName</h3>
                <span>Customer</span>
            </div>
        </div>

        <nav class="menu-links">
            <div class="divider"></div>
            <a asp-controller="Customer" asp-action="CustomerAccountInfo"> <i class="ph ph-user-circle"></i> Account Information </a>
            <a asp-controller="Customer" asp-action="CustomerSecurity"> <i class="ph ph-shield-check"></i> Security and Privacy</a>
            <a asp-controller="Customer" asp-action="CustomerSavedAddresses"> <i class="ph ph-map-pin"></i> My Addresses</a>
            <a asp-controller="Customer" asp-action="CustomerOrderHistory"> <i class="ph ph-clock-counter-clockwise"></i> Order History</a>
            <div class="divider"></div>
            <a href="#" id="openHelpCenterHome"><i class="ph ph-info"></i> Help Center</a>
            <a href="#" id="openTermsHome"><i class="ph ph-scales"></i> Support & Legal</a>
        </nav>
        <div id="helpCenterModalHome" class="help-modal">
            <div class="help-modal-content">
                <button class="help-close-btn">&times;</button>

                <div class="help-header">
                    <h2>SwiftX Help Center</h2>
                    <p>We're here to assist you! Choose a channel to reach us immediately.</p>
                </div>

                <div class="help-channels-container">
                    <a href="https://www.facebook.com/profile.php?id=61577468267412" target="_blank" class="help-card-link">
                        <div class="help-channel-card fb-card">
                            <div class="channel-icon">
                                <i class="ph ph-facebook-logo"></i>
                            </div>
                            <div class="channel-details">
                                <h3>Facebook Messenger</h3>
                                <p>SwiftX Ph</p>
                            </div>
                            <i class="fa-solid fa-chevron-right arrow-icon"></i>
                        </div>
                    </a>

                    <a href="https://mail.google.com/mail/u/0/#inbox?compose=CllgCJNxNzXpkVJRKwvNRhgQmHRrjRHBFSNclDsCpsLLwnVzmGVBqxCkjXpbHPcMgVNQmfKltCg" target="_blank" class="help-card-link">
                        <div class="help-channel-card email-card">
                            <div class="channel-icon">
                                <i class="ph ph-envelope-simple"></i>
                            </div>
                            <div class="channel-details">
                                <h3>Email Support</h3>
                                <p>swiftxph@gmail.com</p>
                            </div>
                            <i class="fa-solid fa-chevron-right arrow-icon"></i>
                        </div>
                    </a>

                    <a href="tel:+639292096887" class="help-card-link">
                        <div class="help-channel-card phone-card">
                            <div class="channel-icon">
                                <i class="ph ph-phone-call"></i>
                            </div>
                            <div class="channel-details">
                                <h3>Hotline Support</h3>
                                <p>0929 209 6887</p>
                            </div>
                            <i class="fa-solid fa-chevron-right arrow-icon"></i>
                        </div>
                    </a>
                </div>
            </div>
        </div>
        <div id="termsModalHome" class="modal">
            <div class="modal-content">
                <span class="close-button-home">&times;</span>

                <div class="terms-text-container">
                    <partial name="_ModalTermsAndConditions" />
                </div>
            </div>
        </div>
        <div class="logout-section">
            <a href="#" class="logout-btn">
                <i class="ph ph-sign-out"></i>
                <span>Log Out</span>
            </a>
        </div>
    </div>
</div>

<!-- MAIN HEADER -->
<header class="top-header">
    <div class="nav-container"> 

        <div class="menu" onclick="toggleMenu()">
            <i class="ph ph-list"></i>
        </div> <div class="hero-text">
        <h1 id="greeting">Hi, <span id="customerName">@Model.FirstName</span></h1>
            <p><b>Welcome To SwiftX</b></p>
        </div> </div>
    </header>

    <!-- CONTENT WRAPPER -->
    <main class="content-wrapper"> </main>

        <!-- SERVICES ROW -->
<section class="services-row">

    @foreach (var service in Model.Services)
    {
        <div class="service-card @(service.Enabled ? "" : "disabled")"
             onclick="selectService(this)">

            <p>@service.Name</p>

            <div class="icon">
                <i class="@service.Icon"></i>
            </div>

        </div>
    }

</section>

        <!-- FEATURED SECTION -->
        <!-- COMING SOON SECTION -->
        <section class="item-section"> 
            <h2 class="section-label">Featured</h2>
    <div class="items-grid">

        @foreach (var item in Model.Featured)
        {
            <div class="item-card">

                <img src="@item.ImageUrl" alt="@item.Title">

            </div>
        }

    </div>
            </section>

@section PageScripts {
    <script src="/js/user/Home/CustomerHome.js" asp-append-version="true"></script>
}