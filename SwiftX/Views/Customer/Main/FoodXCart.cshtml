@{
    ViewData["Title"] = "Your Cart";
    Layout = "~/Views/Shared/_LayoutCustomerSubPage.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/user/customerMain/FoodXCart.css" asp-append-version="true" />
}

<div class="fxc-page">

    <header class="fxc-header">
        <button type="button" id="back-btn" class="fxc-back-btn" aria-label="Go back">
            <i class="ph ph-arrow-left"></i>
        </button>
        <h1 class="fxc-header__title">Your Cart</h1>
    </header>

    <main class="fxc-main" id="cart-items-list"></main>

    <footer class="fxc-footer">
        <div class="fxc-footer__inner">

            <div id="distance-warning-overlay" class="fxc-distance-warning" style="display:none;">
                <i class="ph ph-warning fxc-distance-warning__icon"></i>
                <div>
                    <h4 class="fxc-distance-warning__title">Distance Warning</h4>
                    <p class="fxc-distance-warning__text">
                        Travel distances above 20 km may cause food safety or temperature issues.
                    </p>
                </div>
            </div>

            <div class="fxc-total-row">
                <span class="fxc-total-label">Grand Total</span>
                <span id="cart-total-price" class="fxc-total-price">&#8369; 0.00</span>
            </div>

            <a asp-controller="Customer" asp-action="FoodXCheckout" id="checkout-btn" class="fxc-checkout-btn">
                Proceed to Check-Out
            </a>
        </div>
    </footer>

</div>

@await Html.PartialAsync("_ModalAlert")

@section PageScripts {
    <script src="~/js/modal.js" asp-append-version="true"></script>
    <script src="~/js/modal-alert.js" asp-append-version="true"></script>
    <script src="~/js/user/customerMain/FoodXCart.js" asp-append-version="true"></script>
}
