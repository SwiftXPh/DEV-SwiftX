@{
    ViewData["Title"] = "Coming Soon";
    Layout = "~/Views/Shared/_LayoutError.cshtml";
}

<section class="relative flex items-center justify-center min-h-[80vh] w-full overflow-hidden">
    <!-- Background glow -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full opacity-[0.06] __glow-bg"></div>
    </div>

    <div class="relative flex flex-col items-center text-center px-6 py-16 md:py-20 text-[var(--light-text-color)]">
        <!-- Icon -->
        <div class="__fade-up __fade-up--d1 mb-6">
            <div class="__icon-box w-20 h-20 rounded-full mx-auto flex items-center justify-center">
                <i class="ph ph-user-circle-plus text-[40px]"></i>
            </div>
        </div>

        <span class="__fade-up __fade-up--d1 __pill mb-4">Coming Soon</span>

        <h1 class="__h2 __fade-up __fade-up--d2 max-w-lg">
            Customer Accounts Are <span class="text-[var(--primary-color)]">On the Way</span>
        </h1>

        <p class="__body-lg __fade-up __fade-up--d3 mt-4 max-w-md opacity-60 leading-relaxed">
            Customer sign-in isn't available just yet — we're putting the finishing touches on it.
            In the meantime, you can explore SwiftX or apply to join as a rider or merchant.
        </p>

        <div class="__fade-up __fade-up--d4 flex flex-col sm:flex-row items-center gap-4 mt-8">
            <a asp-controller="Home" asp-action="Index" class="__btn __btn--primary">Back to Home</a>
            <a asp-controller="SignUp" asp-action="Rider" class="__btn __btn--outline">Become a Rider</a>
            <a asp-controller="SignUp" asp-action="Merchant" class="__btn __btn--outline">Become a Merchant</a>
        </div>
    </div>
</section>
