@*

*@

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_LayoutUserLogin.cshtml";
}


<div class="login-container">


    <div class="logo-section">
        <img src="~/Assets/images/swiftx_logo.png" alt="SwiftX Logo" class="logo" />
    </div>

    <h2>Sign In</h2>

    <asp:Panel ID="loginForm" runat="server" DefaultButton="btnSignIn">

        <asp:TextBox 
            ID="txtUsername" 
            runat="server" 
            CssClass="input-field"
            placeholder="Username" />
        <asp:RequiredFieldValidator 
            ID="rfvUsername" 
            runat="server"
            ControlToValidate="txtUsername"
            ErrorMessage="Username is required."
            CssClass="validation-error"
            Display="Dynamic" />

        <div class="password-wrapper">
            <asp:TextBox 
                ID="txtPassword" 
                runat="server" 
                TextMode="Password"
                CssClass="input-field"
                placeholder="Password" />
            <asp:RequiredFieldValidator 
                ID="rfvPassword" 
                runat="server"
                ControlToValidate="txtPassword"
                ErrorMessage="Password is required."
                CssClass="validation-error"
                Display="Dynamic" />
            <i class="ph ph-eye-slash" id="togglePasswordIcon"></i>
        </div>

        <h5 class="divider-text">
            <i>
                By signing in, you agree to our
                <a href="javascript:void(0)" id="openTerms" class="legal-link">
                    Terms and Privacy Policy
                </a>
            </i>
        </h5>

        <asp:Button 
            ID="btnSignIn" 
            runat="server" 
            Text="Sign In"
            CssClass="btn-sign-in"
            OnClick="btnSignIn_Click" />

        <asp:Label 
            ID="lblError" 
            runat="server" 
            CssClass="error-message"
            Visible="false" />

    </asp:Panel>


    <p class="divider-text">Or continue with</p>

    <div class="social-login">
        <button type="button" class="social-btn google" id="btnGoogleLogin">
            <img src="https://cdn-icons-png.flaticon.com/512/2991/2991148.png" alt="Google" />
            Continue with Google
        </button>
    </div>


    <div class="footer-links">
        <span>
            Doesn't have an account? 
            <a asp-area="" asp-controller="Customer" asp-action="CustomerSignup">Register Now</a>
        </span>
        <br />
        <a href="changepassotp.aspx">Forgot Password?</a>
        <br /><br />
        <a href="javascript:void(0)" class="need-help" id="openHelpLink">Need Help?</a>
    </div>

</div>


<div id="helpCenterModal" class="help-modal">
    <div class="help-modal-content">

        <button type="button" class="help-close-btn" id="closeHelpBtn">&times;</button>

        <div class="help-header">
            <h2>SwiftX Help Center</h2>
            <p>We're here to assist you! Choose a channel to reach us immediately.</p>
        </div>

        <div class="help-channels-container">

            <a href="https://www.facebook.com/profile.php?id=61577468267412" 
               target="_blank" 
               rel="noopener noreferrer"
               class="help-card-link">
                <div class="help-channel-card fb-card">
                    <div class="channel-icon"><i class="fa-brands fa-facebook-f"></i></div>
                    <div class="channel-details">
                        <h3>Facebook Messenger</h3>
                        <p>SwiftX Ph</p>
                    </div>
                    <i class="fa-solid fa-chevron-right arrow-icon"></i>
                </div>
            </a>

            <a href="mailto:swiftxph@gmail.com" class="help-card-link">
                <div class="help-channel-card email-card">
                    <div class="channel-icon"><i class="fa-solid fa-envelope"></i></div>
                    <div class="channel-details">
                        <h3>Email Support</h3>
                        <p>swiftxph@gmail.com</p>
                    </div>
                    <i class="fa-solid fa-chevron-right arrow-icon"></i>
                </div>
            </a>

            <a href="tel:+639292096887" class="help-card-link">
                <div class="help-channel-card phone-card">
                    <div class="channel-icon"><i class="fa-solid fa-phone"></i></div>
                    <div class="channel-details">
                        <h3>Hotline Support</h3>
                        <p>0929 209 6887</p>
                    </div>
                    <i class="fa-solid fa-chevron-right arrow-icon"></i>
                </div>
            </a>

        </div>
    </div>
</div>