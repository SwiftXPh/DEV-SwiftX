@model SwiftX.Models.Store
@{
    ViewData["Title"] = $"{Model.BusinessName} - Menu";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<main class="main-container">

    <div class="view-header">
        <button type="button" class="admin-modal-btn admin-modal-btn--ghost"
                onclick="window.location.href='@Url.Action("ManualMerchants", "Admin")'">
            ← Back to Stores
        </button>
        <h1 id="merchantTitleHeader" class="__h2 __text-light" style="margin-top: 16px;">@Model.BusinessName</h1>
        <p style="font-size:12px;color:rgba(255,255,255,0.4);margin-top:4px;">
            @(Model.Category ?? "Store") &middot; @Model.BusinessAddress
        </p>
    </div>

    <input type="hidden" id="currentStoreId" value="@Model.Id" />

    <div class="grid-section" style="margin-top:16px;">
        <button type="button"
                class="add-card-trigger"
                onclick="openAddItemModal()">
            + Add New Item
        </button>
    </div>

    <section class="items-section">
        <h2 class="section-title">Current Items (@(Model.Products?.Count ?? 0))</h2>

        <div id="itemList" class="items-grid">
            @if (Model.Products != null && Model.Products.Any())
            {
                @foreach (var product in Model.Products)
                {
                    <article class="product-card" data-product-id="@product.Id">
                        <div class="product-img-wrapper" style="position:relative;">
                            @if (!string.IsNullOrEmpty(product.ImagePath))
                            {
                                <img src="" alt="@product.Name" class="product-image" 
                                     data-image-path="@product.ImagePath"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                <div class="product-image product-image--placeholder" style="display:none;align-items:center;justify-content:center;background:rgba(255,255,255,0.05);height:100%;min-height:140px;border-radius:12px;">
                                    <i class="ph ph-bowl-food" style="font-size:2rem;opacity:0.4;"></i>
                                </div>
                            }
                            else
                            {
                                <div class="product-image product-image--placeholder" style="display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,0.05);height:100%;min-height:140px;border-radius:12px;">
                                    <i class="ph ph-bowl-food" style="font-size:2rem;opacity:0.4;"></i>
                                </div>
                            }
                            @if (!product.IsAvailable)
                            {
                                <span class="admin-badge admin-badge--inactive" style="position:absolute;top:8px;right:8px;">Unavailable</span>
                            }
                        </div>
                        <h3 class="product-title" style="margin-top:10px;">@product.Name</h3>
                        <p class="product-price">₱@product.Price.ToString("N2")</p>
                        @if (!string.IsNullOrEmpty(product.Category))
                        {
                            <span class="td-category" style="margin-bottom:8px;display:inline-block;">@product.Category</span>
                        }
                        @if (!string.IsNullOrEmpty(product.Description))
                        {
                            <p style="font-size:11px;color:rgba(255,255,255,0.4);margin-bottom:8px;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">@product.Description</p>
                        }
                        <div class="product-actions">
                            <button type="button" class="admin-modal-btn admin-modal-btn--ghost" onclick="editItem(@product.Id)">Edit</button>
                            <button type="button" class="admin-modal-btn admin-modal-btn--danger" onclick="deleteItem(@product.Id)">Delete</button>
                        </div>
                    </article>
                }
            }
            else
            {
                <p class="__text-light" style="grid-column: 1/-1; text-align: center; opacity: 0.6; padding: 2rem;">
                    No menu items found. Click 'Add New Item' to begin.
                </p>
            }
        </div>
    </section>
</main>

<!-- Hidden Delete Form -->
<form id="deleteProductForm" method="post" asp-action="DeleteProduct" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteProductId" value="" />
    <input type="hidden" name="storeId" value="@Model.Id" />
</form>

@await Html.PartialAsync("_ModalAlert")
@await Html.PartialAsync("_ModalMenuItemAdd")

@section Scripts {
    <script src="~/js/modal.js" asp-append-version="true"></script>
    <script src="~/js/modal-alert.js" asp-append-version="true"></script>
    <script src="~/js/MenuInfo.js" asp-append-version="true"></script>
}