@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="dash-welcome">
    <div class="dash-welcome__left">
        <p class="dash-welcome__greeting">Welcome back</p>
        <h2 class="dash-welcome__name">@(User.Identity?.Name ?? "Admin")</h2>
        <p class="dash-welcome__sub">Here's what's happening with SwiftX today.</p>
    </div>
    <div class="dash-welcome__date">
        <strong id="dash-date">—</strong>
        <span id="dash-time">—</span>
    </div>
</div>

@* {{-- ── Stat Cards ── --}} *@
<div class="admin-stat-grid">
    <div class="admin-stat-card">
        <div class="admin-stat-header">
            <div class="admin-stat-icon"><i class="ph ph-package"></i></div>
        </div>
        <p class="admin-stat-value">@ViewBag.TotalOrders</p>
        <p class="admin-stat-label">Total Orders</p>
    </div>

    <div class="admin-stat-card">
        <div class="admin-stat-header">
            <div class="admin-stat-icon"><i class="ph ph-motorcycle"></i></div>
        </div>
        <p class="admin-stat-value">@ViewBag.ActiveRiders</p>
        <p class="admin-stat-label">Active Riders</p>
    </div>

    <div class="admin-stat-card">
        <div class="admin-stat-header">
            <div class="admin-stat-icon"><i class="ph ph-storefront"></i></div>
        </div>
        <p class="admin-stat-value">@ViewBag.ActiveMerchants</p>
        <p class="admin-stat-label">Partner Merchants</p>
    </div>

    <div class="admin-stat-card">
        <div class="admin-stat-header">
            <div class="admin-stat-icon"><i class="ph ph-currency-circle-dollar"></i></div>
        </div>
        <p class="admin-stat-value">&#8369;@(((decimal)ViewBag.MonthlyRevenue).ToString("N0"))</p>
        <p class="admin-stat-label">Revenue (This Month)</p>
    </div>
</div>

@* 
{{-- ── Application Summary ── --}} 
*@

<div class="dash-app-grid">

    <a asp-area="" asp-controller="Admin" asp-action="RiderApplications" class="dash-app-card">
        <div class="dash-app-card__icon">
            <i class="ph ph-user-circle-plus"></i>
        </div>
        <div class="dash-app-card__body">
            <p class="dash-app-card__label">Applications</p>
            <p class="dash-app-card__title">Rider Applications</p>
            <div class="dash-app-card__pills">
                @* PENDING *@
                <span class="dash-app-pill dash-app-pill--pending">
                    <span class="dash-app-pill__dot"></span>@ViewBag.PendingRiders Pending
                </span>
                @*
                    ==== APPROVED ====
                <span class="dash-app-pill dash-app-pill--approved">
                    <span class="dash-app-pill__dot"></span>12 Approved
                </span>
                    ==== REJECTED ===
                <span class="dash-app-pill dash-app-pill--rejected">
                    <span class="dash-app-pill__dot"></span>2 Rejected
                </span>
                *@
            </div>
        </div>
        <span class="dash-app-card__action">
            Review <i class="ph ph-arrow-right"></i>
        </span>
    </a>

    <a asp-area="" asp-controller="Admin" asp-action="MerchantApplications" class="dash-app-card">
        <div class="dash-app-card__icon">
            <i class="ph ph-clipboard-text"></i>
        </div>
        <div class="dash-app-card__body">
            <p class="dash-app-card__label">Applications</p>
            <p class="dash-app-card__title">Merchant Applications</p>
            <div class="dash-app-card__pills">

                @* PENDING *@
                <span class="dash-app-pill dash-app-pill--pending">
                    <span class="dash-app-pill__dot"></span>@ViewBag.PendingMerchants Pending
                </span>
                @*
                    ==== APPROVED ====
                    <span class="dash-app-pill dash-app-pill--approved">
                        <span class="dash-app-pill__dot"></span>8 Approved
                    </span>

                    ==== REJECTED ===
                    <span class="dash-app-pill dash-app-pill--rejected">
                        <span class="dash-app-pill__dot"></span>1 Rejected
                    </span>
                *@
            </div>
        </div>
        <span class="dash-app-card__action">
            Review <i class="ph ph-arrow-right"></i>
        </span>
    </a>

</div>

@*
    {{-- ── Bottom Grid: Recent Orders + Activity ── --}} 
*@

<div class="dash-bottom-grid">

    <div class="admin-table-card admin-table-card--flush">
        <div class="admin-table-header">
            <div>
                <h2 class="admin-table-title">Recent Orders</h2>
                <p class="admin-table-subtitle">Last 5 transactions</p>
            </div>
            <a asp-area="" asp-controller="Admin" asp-action="Orders" class="dash-view-all">
                View All <i class="ph ph-arrow-right"></i>
            </a>
        </div>
        <div class="admin-table-wrap">
            <table class="admin-table" id="recent_orders">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Customer</th>
                        <th>Merchant</th>
                        <th>Status</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var recentOrders = (List<SwiftX.Models.Order>)ViewBag.RecentOrders;
                    }
                    @if (recentOrders.Any())
                    {
                        @foreach (var order in recentOrders)
                        {
                            var statusLower = order.Status?.ToLower().Replace(" ", "-") ?? "pending";
                            var badgeClass = statusLower switch
                            {
                                "delivered" => "admin-badge--delivered",
                                "in-transit" => "admin-badge--in-transit",
                                "pending" => "admin-badge--pending",
                                "cancelled" => "admin-badge--cancelled",
                                _ => "admin-badge--pending"
                            };
                            var customerName = order.Customer?.User != null
                                ? $"{order.Customer.User.FirstName} {order.Customer.User.LastName}"
                                : "—";
                            var merchantName = order.Merchant?.BusinessName ?? "—";

                            <tr>
                                <td><span class="dash-order-id">#ORD-@order.Id.ToString("D4")</span></td>
                                <td><span class="dash-customer">@customerName</span></td>
                                <td><span class="dash-merchant">@merchantName</span></td>
                                <td>
                                    <span class="admin-badge @badgeClass">
                                        <span class="admin-badge-dot"></span>@order.Status
                                    </span>
                                </td>
                                <td><span class="dash-amount">&#8369;@order.TotalAmount.ToString("N0")</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" style="text-align:center;padding:2rem;opacity:0.5;">
                                <i class="ph ph-package" style="font-size:2rem;"></i>
                                <p style="margin-top:0.5rem;">No orders yet.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="dash-activity-card">
        <div class="dash-activity-header">
            <h2 class="admin-table-title">Recent Activity</h2>
        </div>
        <ul class="dash-activity-feed">
            @{
                var recentActivities = (List<dynamic>)ViewBag.RecentActivities;

                string TimeAgo(DateTime dt) {
                    var span = DateTime.UtcNow - dt;
                    if (span.TotalMinutes < 1) return "Just now";
                    if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} min ago";
                    if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
                    if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
                    return dt.ToString("MMM dd, yyyy");
                }
            }
            @if (recentActivities.Any())
            {
                @foreach (var a in recentActivities)
                {
                    <li class="dash-activity-item">
                        <div class="dash-activity-dot @a.DotClass">
                            <i class="ph @a.Icon"></i>
                        </div>
                        <div>
                            <p class="dash-activity-text">
                                <strong>@a.Name</strong> @a.Text
                            </p>
                            <p class="dash-activity-time">@TimeAgo((DateTime)a.Date)</p>
                        </div>
                    </li>
                }
            }
            else
            {
                <li class="dash-activity-item" style="opacity:0.5;justify-content:center;">
                    <p>No recent activity.</p>
                </li>
            }
        </ul>
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
        });

        function updateClock() {
            const now = new Date();
            const dateOpts = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            const timeOpts = { hour: '2-digit', minute: '2-digit', second: '2-digit' };
            document.getElementById('dash-date').textContent = now.toLocaleDateString('en-PH', dateOpts);
            document.getElementById('dash-time').textContent = now.toLocaleTimeString('en-PH', timeOpts);
        }
        updateClock();
        setInterval(updateClock, 1000);
    </script>
}
