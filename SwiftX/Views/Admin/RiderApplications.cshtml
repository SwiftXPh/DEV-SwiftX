@model List<SwiftX.Models.Rider>
@{
    ViewData["Title"] = "Riders Application";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var totalApplications = Model.Count;
    var pendingCount = Model.Count(r => r.Status == "Pending");
    var approvedCount = Model.Count(r => r.Status == "Active");
    var rejectedCount = Model.Count(r => r.Status == "Rejected");
}

<div class="admin-stat-grid" style="margin-bottom:22px;">
    <div class="admin-stat-card">
        <div class="admin-stat-header">
            <div class="admin-stat-icon"><i class="ph ph-clock"></i></div>
        </div>
        <p class="admin-stat-value">@pendingCount</p>
        <p class="admin-stat-label">Pending Review</p>
    </div>
    <div class="admin-stat-card">
        <div class="admin-stat-header"><div class="admin-stat-icon"><i class="ph ph-check-circle"></i></div></div>
        <p class="admin-stat-value">@approvedCount</p>
        <p class="admin-stat-label">Accepted</p>
    </div>
    <div class="admin-stat-card">
        <div class="admin-stat-header"><div class="admin-stat-icon"><i class="ph ph-x-circle"></i></div></div>
        <p class="admin-stat-value">@rejectedCount</p>
        <p class="admin-stat-label">Rejected</p>
    </div>
    <div class="admin-stat-card">
        <div class="admin-stat-header"><div class="admin-stat-icon"><i class="ph ph-users"></i></div></div>
        <p class="admin-stat-value">@totalApplications</p>
        <p class="admin-stat-label">Total Applications</p>
    </div>
</div>

<!-- TABLE CARD -->
<div class="admin-table-card">
    <div class="admin-table-header">
        <div>
            <h2 class="admin-table-title">All Rider Applications</h2>
            <p style="font-size:11px;color:rgba(255,255,255,0.3);margin-top:3px;">
                @totalApplications total &middot; @pendingCount pending &middot; @approvedCount accepted &middot; @rejectedCount rejected
            </p>
        </div>
        <div class="admin-table-actions">
            <div class="admin-search">
                <i class="ph ph-magnifying-glass"></i>
                <input type="text" id="apps-search" placeholder="Search applicants..." />
            </div>
            <div class="admin-filter-bar" id="apps-filter-bar">
                <button class="admin-filter-btn active" data-filter="all">All</button>
                <button class="admin-filter-btn" data-filter="pending">Pending</button>
                <button class="admin-filter-btn" data-filter="approved">Approved</button>
                <button class="admin-filter-btn" data-filter="rejected">Rejected</button>
            </div>
        </div>
    </div>

    <div class="admin-table-wrap">
        <table class="admin-table" id="apps_table">
            <thead>
                <tr>
                    <th>Applicant</th>
                    <th>Contact</th>
                    <th>GCash</th>
                    <th>Applied</th>
                    <th>Status</th>
                    <th style="width:120px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rider in Model)
                {
                    var fullName = $"{rider.User.FirstName} {rider.User.LastName}";
                    var isPending = rider.Status == "Pending";
                    var isApproved = rider.Status == "Active";
                    var isRejected = rider.Status == "Rejected";

                    var badgeClass = isPending ? "admin-badge--pending" :
                                     isApproved ? "admin-badge--active" :
                                     "admin-badge--rejected";
                    var badgeLabel = isPending ? "Pending" :
                                     isApproved ? "Approved" :
                                     "Rejected";
                    var rowMuted = isRejected ? " td-person--muted" : "";
                    var avatarMuted = isRejected ? " td-person__avatar--muted" : "";

                    <tr>
                        <td>
                            <div class="td-person@(rowMuted)">
                                <div class="td-person__avatar@(avatarMuted)"><i class="ph ph-user"></i></div>
                                <div>
                                    <p class="td-person__name">@fullName</p>
                                    <p class="td-person__sub">@rider.User.Email</p>
                                </div>
                            </div>
                        </td>
                        <td style="font-size:var(--fs-small);">@rider.User.Contact</td>
                        <td style="font-size:var(--fs-small);">@rider.GCContact</td>
                        <td style="font-size:var(--fs-small);color:rgba(255,255,255,0.55);">@rider.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td><span class="admin-badge @badgeClass"><span class="admin-badge-dot"></span>@badgeLabel</span></td>
                        <td>
                            <div class="admin-actions-cell">
                                <button class="admin-action-btn" title="View Application"
                                        onclick="viewRiderApplication(@rider.Id)">
                                    <i class="ph ph-eye"></i>
                                </button>
                                @if (isPending)
                                {
                                    <form asp-controller="Admin" asp-action="ApproveRider" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@rider.Id" />
                                        <button type="submit" class="admin-action-btn admin-action-btn--approve" title="Quick Accept">
                                            <i class="ph ph-check"></i>
                                        </button>
                                    </form>
                                    <form asp-controller="Admin" asp-action="RejectRider" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@rider.Id" />
                                        <button type="submit" class="admin-action-btn admin-action-btn--reject" title="Quick Reject">
                                            <i class="ph ph-x"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="admin-pagination" id="apps-dt-footer"></div>
</div>

@section Scripts {
    <script>
        $(function () {
            var appsTable = $('#apps_table').DataTable({
                pageLength: 10,
                ordering: true,
                searching:    true,
                lengthChange: false,
                responsive: true,
                autoWidth: false,
                dom: 't<"admin-pagination"<"dataTables_info"i><"admin-pagination-btns"p>>',
                columnDefs: [
                    { orderable: false, targets: [5] }
                ],
                language: {
                    paginate: {
                        previous: '<i class="ph ph-caret-left"></i>',
                        next:     '<i class="ph ph-caret-right"></i>'
                    },
                    info: 'Showing _START_–_END_ of _TOTAL_ applicants',
                    emptyTable: '<div style="text-align:center;padding:2rem;opacity:0.5;"><i class="ph ph-file-text" style="font-size:2rem;"></i><p style="margin-top:0.5rem;">No rider applications found.</p></div>'
                },
                drawCallback: function () {
                    $(this.api().table().container())
                        .find('.dataTables_paginate .paginate_button')
                        .addClass('admin-page-btn')
                        .filter('.current').addClass('active');
                }
            });

            $('#apps-search').on('input', function () {
                appsTable.search(this.value).draw();
            });

            $('#apps-filter-bar').on('click', '.admin-filter-btn', function () {
                $('#apps-filter-bar .admin-filter-btn').removeClass('active');
                $(this).addClass('active');
                var f = $(this).data('filter');
                var term = '';
                if (f === 'approved') term = '^Approved$';
                else if (f !== 'all') term = '^' + f.charAt(0).toUpperCase() + f.slice(1) + '$';
                appsTable.column(4).search(term, true, false).draw();
            });
        });
    </script>
}

@await Html.PartialAsync("_ModalRiderApplication")
@await Html.PartialAsync("_ModalDocPreview")