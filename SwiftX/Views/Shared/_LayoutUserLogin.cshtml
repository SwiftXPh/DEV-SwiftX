<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | SwiftX</title>

    <!-- CDN-like link for Tailwind CSS -->
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/mainroot.css">
    <link rel="stylesheet" href="~/css/user/auth/login.css">

    <link rel="icon" type="image/x-icon" href="~/favicon.ico">

    <!-- PHOSPOR ICONS -->
    <link rel="stylesheet" href="~/lib/phosphor-icons/regular/style.css" />
    <link rel="stylesheet" href="~/lib/phosphor-icons/bold/style.css" />
    <link rel="stylesheet" href="~/lib/phosphor-icons/fill/style.css" />

</head>
<body class="__fullpage">

    <main role="main" class="mt-0 __main">
        @RenderBody()
    </main>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/script.js/config.js"></script>

    <script src="~/script.js/user/auth/login.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
