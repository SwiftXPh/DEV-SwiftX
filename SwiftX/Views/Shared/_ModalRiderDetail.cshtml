@{

}

<div class="admin-modal-overlay" id="rider-detail-modal">
    <div class="admin-modal admin-modal--lg">
        <div class="admin-modal__header">
            <h2 class="admin-modal__title">
                <i class="ph ph-motorcycle"></i> Rider Profile
            </h2>
            <button class="admin-modal__close" onclick="closeModal('rider-detail-modal')">
                <i class="ph ph-x"></i>
            </button>
        </div>
        <div class="admin-modal__body">

            <!-- ── Hero ── -->
            <div class="rmod-hero">
                <div class="rmod-hero__av-wrap">
                    <div class="rmod-hero__av-fallback" style="display:flex;">
                        <i class="ph ph-user"></i>
                    </div>
                    <span class="rmod-hero__av-dot rmod-hero__av-dot--active" id="rmod-status-dot"></span>
                </div>
                <div>
                    <p class="rmod-hero__name" id="rmod-hero-name">—</p>
                    <div class="rmod-hero__meta">
                        <span class="rmod-hero__id" id="rmod-hero-id">Rider-000</span>
                        <span class="admin-badge admin-badge--active" id="rmod-hero-badge">
                            <span class="admin-badge-dot"></span><span id="rmod-hero-status">Active</span>
                        </span>
                    </div>
                </div>
                <div class="rmod-hero__btns">
                    <button class="admin-modal-btn admin-modal-btn--ghost" onclick="editRiderDetail(_currentRiderId)">
                        <i class="ph ph-pencil-simple"></i> Edit
                    </button>
                    <button class="admin-modal-btn admin-modal-btn--danger">
                        <i class="ph ph-prohibit"></i> Deactivate
                    </button>
                </div>
            </div>

            <!-- ── Tabs ── -->
            <div class="rmod-tabs">
                <button class="rmod-tab active" data-tab="rmod-info">
                    <i class="ph ph-identification-card"></i> Information
                </button>
                <button class="rmod-tab" data-tab="rmod-docs">
                    <i class="ph ph-files"></i> Documents
                </button>
                <button class="rmod-tab" data-tab="rmod-activity">
                    <i class="ph ph-list-checks"></i> Activity Log
                </button>
            </div>

            <!-- ── TAB: Information ── -->
            <div class="rmod-panel active" id="rmod-info">
                <div class="rmod-info-grid">
                    <div class="rmod-info-block">
                        <p class="rmod-info-block__lbl">Full Name</p>
                        <p class="rmod-info-block__val" id="rmod-fullname">—</p>
                    </div>
                    <div class="rmod-info-block">
                        <p class="rmod-info-block__lbl">Phone</p>
                        <p class="rmod-info-block__val" id="rmod-phone">—</p>
                    </div>
                    <div class="rmod-info-block">
                        <p class="rmod-info-block__lbl">Email</p>
                        <p class="rmod-info-block__val" id="rmod-email">—</p>
                    </div>
                    <div class="rmod-info-block">
                        <p class="rmod-info-block__lbl">Address</p>
                        <p class="rmod-info-block__val" id="rmod-address">—</p>
                    </div>
                    <div class="rmod-info-block">
                        <p class="rmod-info-block__lbl">Date Registered</p>
                        <p class="rmod-info-block__val" id="rmod-registered">—</p>
                    </div>
                    <div class="rmod-info-block">
                        <p class="rmod-info-block__lbl">Plate Number</p>
                        <p class="rmod-info-block__val" id="rmod-plate">—</p>
                    </div>
                    <div class="rmod-info-block">
                        <p class="rmod-info-block__lbl">Payment Method</p>
                        <p class="rmod-info-block__val" id="rmod-gcash">—</p>
                    </div>
                </div>
            </div>

            <!-- ── TAB: Documents ── -->
            <div class="rmod-panel" id="rmod-docs">
                <p class="rmod-docs-hint">
                    Submitted requirements and their current verification status.
                </p>

                <div class="rmod-doc-row">
                    <div>
                        <p class="rmod-doc-row__name">Professional Driver's License</p>
                        <p class="rmod-doc-row__sub">Uploaded document</p>
                    </div>
                    <div class="rmod-doc-row__right">
                        <button class="admin-modal-doc__preview-btn" id="rmod-doc-license-btn" onclick="openRiderDoc('license')">
                            <i class="ph ph-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="rmod-doc-row">
                    <div>
                        <p class="rmod-doc-row__name">Secondary Government ID</p>
                        <p class="rmod-doc-row__sub">Uploaded document</p>
                    </div>
                    <div class="rmod-doc-row__right">
                        <button class="admin-modal-doc__preview-btn" id="rmod-doc-id-btn" onclick="openRiderDoc('id')">
                            <i class="ph ph-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="rmod-doc-row">
                    <div>
                        <p class="rmod-doc-row__name">OR / CR of Motorcycle</p>
                        <p class="rmod-doc-row__sub">Uploaded document</p>
                    </div>
                    <div class="rmod-doc-row__right">
                        <button class="admin-modal-doc__preview-btn" id="rmod-doc-orcr-btn" onclick="openRiderDoc('orcr')">
                            <i class="ph ph-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="rmod-doc-row">
                    <div>
                        <p class="rmod-doc-row__name">Clear Vehicle Photos (Front)</p>
                        <p class="rmod-doc-row__sub">Uploaded document</p>
                    </div>
                    <div class="rmod-doc-row__right">
                        <button class="admin-modal-doc__preview-btn" id="rmod-doc-front-btn" onclick="openRiderDoc('front')">
                            <i class="ph ph-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="rmod-doc-row">
                    <div>
                        <p class="rmod-doc-row__name">Clear Vehicle Photos (Side)</p>
                        <p class="rmod-doc-row__sub">Uploaded document</p>
                    </div>
                    <div class="rmod-doc-row__right">
                        <button class="admin-modal-doc__preview-btn" id="rmod-doc-side-btn" onclick="openRiderDoc('side')">
                            <i class="ph ph-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="rmod-doc-row">
                    <div>
                        <p class="rmod-doc-row__name">Verified GCash Account</p>
                        <p class="rmod-doc-row__sub" id="rmod-doc-gcash-num">—</p>
                    </div>
                    <div class="rmod-doc-row__right">
                        <span class="rmod-doc-status rmod-doc-status--ok">
                            <i class="ph ph-check-circle"></i> Provided
                        </span>
                    </div>
                </div>
            </div>

            <!-- ── TAB: Activity Log ── -->
            <div class="rmod-panel" id="rmod-activity">
                <div class="admin-stat-details-grid">
                    <div class="admin-stat-details">
                        <div class="admin-stat-header">
                            <div class="admin-stat-icon"><i class="ph ph-package"></i></div>
                        </div>
                        <p class="admin-stat-value">—</p>
                        <p class="admin-stat-label">Today's Deliveries</p>
                    </div>
                    <div class="admin-stat-details">
                        <div class="admin-stat-header">
                            <div class="admin-stat-icon"><i class="ph ph-check-circle"></i></div>
                        </div>
                        <p class="admin-stat-value">—</p>
                        <p class="admin-stat-label">All Deliveries</p>
                    </div>
                    <div class="admin-stat-details">
                        <div class="admin-stat-header">
                            <div class="admin-stat-icon"><i class="ph ph-map-pin"></i></div>
                        </div>
                        <p class="admin-stat-value">—</p>
                        <p class="admin-stat-label">Total Mileage</p>
                    </div>
                </div>

                <div class="admin-modal-table-wrap">
                    <table class="admin-table admin-table--compact" id="rider-activity-table">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Time</th>
                                <th>Pickup</th>
                                <th>Drop-Off</th>
                                <th>Status</th>
                                <th>Earnings</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="6" style="text-align:center;opacity:0.5;padding:1.5rem;">
                                    No activity data yet.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- ── Footer ── -->
            <div class="rmod-footer">
                <button class="admin-modal-btn admin-modal-btn--ghost"
                        onclick="closeModal('rider-detail-modal')">
                    Close
                </button>
            </div>

        </div>
    </div>
</div>

<script>
    // Store current rider doc paths for preview buttons
    var _riderDocPaths = {};
    var _currentRiderId = 0;

    function viewRiderDetail(riderId) {
        _currentRiderId = riderId;
        fetch('/Admin/GetRiderJson?id=' + riderId)
            .then(function (res) { return res.json(); })
            .then(function (r) {
                // Hero
                document.getElementById('rmod-hero-name').textContent = r.fullName;
                document.getElementById('rmod-hero-id').textContent = r.riderId;
                document.getElementById('rmod-hero-status').textContent = r.status;

                // Badge class
                var badge = document.getElementById('rmod-hero-badge');
                badge.className = 'admin-badge admin-badge--' + r.status.toLowerCase();

                // Status dot
                var dot = document.getElementById('rmod-status-dot');
                dot.className = 'rmod-hero__av-dot rmod-hero__av-dot--' + r.status.toLowerCase();

                // Information tab
                document.getElementById('rmod-fullname').textContent = r.fullName;
                document.getElementById('rmod-phone').textContent = r.phone || '—';
                document.getElementById('rmod-email').textContent = r.email || '—';
                document.getElementById('rmod-address').textContent = r.address || '—';
                document.getElementById('rmod-registered').textContent = r.createdAt;
                document.getElementById('rmod-plate').textContent = r.plateNumber;
                document.getElementById('rmod-gcash').textContent = r.gcContact ? 'GCash — ' + r.gcContact : '—';

                // Documents tab - store paths
                _riderDocPaths = {
                    license: r.licensePath,
                    id: r.idPath,
                    orcr: r.orcrPath,
                    front: r.frontVehiclePath,
                    side: r.sideVehiclePath
                };

                // GCash number in docs tab
                document.getElementById('rmod-doc-gcash-num').textContent = r.gcContact || '—';

                openModal('rider-detail-modal');
            });
    }

    function openRiderDoc(docType) {
        var path = _riderDocPaths[docType];
        if (path) {
            var ext = path.split('.').pop().toLowerCase();
            var type = (ext === 'pdf') ? 'pdf' : 'image';
            var labels = {
                license: "Driver's License",
                id: "Government ID",
                orcr: "OR/CR of Motorcycle",
                front: "Vehicle Photo (Front)",
                side: "Vehicle Photo (Side)"
            };
            openDocPreview(type, path, labels[docType] || 'Document');
        }
    }
</script>