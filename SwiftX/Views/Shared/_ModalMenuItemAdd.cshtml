@* Views/Shared/_ModalMenuItemAdd.cshtml *@

<div id="menuitem-add-modal" class="admin-modal-overlay">
    <div class="admin-modal admin-modal--sm">

        <div class="admin-modal__header">
            <div class="admin-modal__title">
                <i class="ph ph-bowl-food"></i>
                <span id="formTitle">Add New Menu Item</span>
            </div>

            <button type="button"
                    class="admin-modal__close"
                    onclick="closeModal('menuitem-add-modal')"
                    aria-label="Close">
                <i class="ph ph-x"></i>
            </button>
        </div>

        <div class="admin-modal__body">

            <form id="menuItemForm" method="post" enctype="multipart/form-data" asp-controller="Admin" asp-action="AddProduct">
                @Html.AntiForgeryToken()
                <input type="hidden" id="productId" name="Id" value="0" />
                <input type="hidden" id="productStoreId" name="StoreId" value="" />

                <div class="emod-grid">

                    <div class="emod-field emod-field--full">
                        <label class="emod-field__label" for="productName">Item Name</label>
                        <input type="text"
                               id="productName"
                               name="Name"
                               class="admin-modal-input"
                               placeholder="e.g. 2-pc. Chicken McDo"
                               required />
                    </div>

                    <div class="emod-field emod-field--full">
                        <label class="emod-field__label" for="productPrice">Price (₱)</label>
                        <input type="number"
                               id="productPrice"
                               name="Price"
                               class="admin-modal-input"
                               placeholder="0.00"
                               step="0.01"
                               min="0"
                               required />
                    </div>

                    <div class="emod-field emod-field--full">
                        <label class="emod-field__label" for="productCategory">Category</label>
                        <input type="text"
                               id="productCategory"
                               name="Category"
                               class="admin-modal-input"
                               placeholder="e.g. Chicken, Burgers, Desserts, Drinks" />
                    </div>

                    <div class="emod-field emod-field--full">
                        <label class="emod-field__label" for="productDescription">Description</label>
                        <textarea id="productDescription"
                                  name="Description"
                                  class="admin-modal-input"
                                  placeholder="Optional item description..."
                                  rows="2"></textarea>
                    </div>

                    <div class="emod-field emod-field--full" id="availabilityField" style="display:none;">
                        <label class="emod-field__label" for="productAvailability">Availability</label>
                        <select id="productAvailability" name="IsAvailable" class="admin-modal-input">
                            <option value="true" selected>Available</option>
                            <option value="false">Unavailable</option>
                        </select>
                    </div>

                    <div class="emod-field emod-field--full">
                        <label class="emod-field__label" for="productImage">Item Image</label>

                        <div class="admin-modal-upload" id="productImageUpload">
                            <input type="file"
                                   id="productImage"
                                   name="Image"
                                   class="admin-modal-upload__input"
                                   accept="image/*">

                            <span class="admin-modal-upload__label">
                                <img id="productImagePreview"
                                     class="admin-modal-upload__preview"
                                     alt="">

                                <i class="ph ph-image"></i>
                                <span id="productImageText">Upload Item Image</span>
                            </span>
                        </div>

                        <span id="productImageError"
                              class="admin-modal-upload-error"></span>
                    </div>

                </div>

                <div class="admin-modal-footer-actions">
                    <button type="button"
                            class="admin-modal-btn admin-modal-btn--ghost"
                            onclick="closeModal('menuitem-add-modal')">
                        Cancel
                    </button>

                    <button type="submit"
                            class="admin-modal-btn admin-modal-btn--primary">
                        Save
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>