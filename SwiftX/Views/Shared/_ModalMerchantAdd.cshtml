@* Views/Shared/_ModalMerchantAdd.cshtml *@

<div id="merchant-add-modal" class="admin-modal-overlay">
    <div class="admin-modal admin-modal--sm">

        <div class="admin-modal__header">
            <div class="admin-modal__title">
                <i class="ph ph-storefront"></i>
                <span id="formTitle">Add New Merchant</span>
            </div>
            <button type="button" class="admin-modal__close" onclick="closeModal('merchant-add-modal')" aria-label="Close">
                <i class="ph ph-x"></i>
            </button>
        </div>

        <div class="admin-modal__body">
            <form id="merchantForm" method="post" enctype="multipart/form-data" asp-controller="Admin" asp-action="AddMerchant">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editIndex" value="-1">

                <div class="emod-grid">

                    <div class="emod-field emod-field--full">
                        <label id="labelName" class="emod-field__label" for="businessName">Business Name</label>
                        <input type="text" id="businessName" name="BusinessName" class="admin-modal-input" required placeholder="Mcdonalds Valencia">
                    </div>

                    <div class="emod-field emod-field--full" style="position: relative;">
                        <label id="labelLocation" class="emod-field__label" for="businessLocation">Business Location</label>
                        <input type="text" id="businessLocation" name="BusinessLocation" class="admin-modal-input" required placeholder="Choose on Map" autocomplete="off">
                        <input type="hidden" id="latitude" name="Latitude">
                        <input type="hidden" id="longitude" name="Longitude">
                        <div id="places-dropdown" class="places-dropdown" style="display: none;"></div>
                        <div id="location-map"></div>
                        <small class="admin-modal-help-text" style="display: block; margin-top: 8px; color: rgba(255,255,255,0.5); font-size: 12px;">Click the map to drop a pin, or drag the pin to adjust.</small>
                    </div>

                    <div class="emod-field emod-field--full">
                        <label id="labelCategory" class="emod-field__label" for="businessCategory">Business Category</label>
                        <select id="businessCategory" name="BusinessCategory" class="admin-modal-input" required>
                            <option value="" disabled selected>Dropdown: Restaurants, Cafe etc</option>
                            <option value="Restaurant">Restaurant</option>
                            <option value="Cafe">Cafe</option>
                            <option value="Fastfood">Fastfood</option>
                        </select>
                    </div>

                    <div class="emod-field emod-field--full">
                        <label id="labelOwner" class="emod-field__label" for="merchantId">Store Owner</label>
                        <select id="merchantId" name="MerchantId" class="admin-modal-input">
                            <option value="">Admin Managed (No Merchant)</option>
                            @if (ViewBag.ApprovedMerchants != null)
                            {
                                foreach (var merchant in (List<SwiftX.Models.Merchant>)ViewBag.ApprovedMerchants)
                                {
                                    <option value="@merchant.Id">@merchant.BusinessName</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="emod-field emod-field--full">
                        <label id="labelLogo" class="emod-field__label" for="businessLogo">Business Logo</label>
                        <div class="admin-modal-upload" id="businessLogoUpload">
                            <input type="file" id="businessLogo" name="BusinessLogo" class="admin-modal-upload__input" accept="image/*">
                            <span class="admin-modal-upload__label">
                                <img id="businessLogoPreview" class="admin-modal-upload__preview" alt="">
                                <i class="ph ph-upload-simple"></i>
                                <span id="businessLogoText">Upload Photo</span>
                            </span>
                        </div>
                        <span id="businessLogoError" class="admin-modal-upload-error"></span>
                    </div>

                </div>

                <div class="admin-modal-footer-actions">
                    <button type="button" class="admin-modal-btn admin-modal-btn--ghost" onclick="closeModal('merchant-add-modal')">Cancel</button>
                    <button type="submit" class="admin-modal-btn admin-modal-btn--primary">Save</button>
                </div>
            </form>
        </div>

    </div>
</div>


