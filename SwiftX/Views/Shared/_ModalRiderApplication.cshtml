@{

}

<div class="admin-modal-overlay" id="rider-application-modal">
    <div class="admin-modal admin-modal--lg">
        <div class="admin-modal__header">
            <h2 class="admin-modal__title">
                <i class="ph ph-file-text"></i> Rider Application Review
            </h2>
            <button class="admin-modal__close" onclick="closeModal('rider-application-modal')">
                <i class="ph ph-x"></i>
            </button>
        </div>
        <div class="admin-modal__body">

            <!-- ══ HERO ══ -->
            <div class="appmod-hero">
                <div class="appmod-hero__photo-wrap">
                    <div class="appmod-hero__photo-fallback" style="display:flex;">
                        <i class="ph ph-user"></i>
                    </div>
                    <span class="appmod-hero__dot"></span>
                </div>

                <div class="appmod-hero__info">
                    <p class="appmod-hero__name" id="rapp-hero-name">—</p>
                    <div class="appmod-hero__meta">
                        <span class="admin-badge admin-badge--pending" id="rapp-hero-badge">
                            <span class="admin-badge-dot"></span><span id="rapp-hero-status">Pending Review</span>
                        </span>
                        <span class="appmod-hero__chip">
                            <i class="ph ph-calendar-blank"></i> <span id="rapp-applied-date">—</span>
                        </span>
                    </div>
                </div>

                <span class="appmod-hero__chip appmod-hero__chip--id">
                    <i class="ph ph-hash"></i> <span id="rapp-hero-id">APP-000</span>
                </span>
            </div>

            <!-- ══ BODY: 2 columns ══ -->
            <div class="appmod-body">

                <!-- Left: Applicant Info -->
                <div class="admin-modal-section">
                    <h3 class="admin-modal-section__title">
                        <i class="ph ph-identification-card admin-modal-section__icon"></i>
                        Applicant Information
                    </h3>
                    <div class="appmod-info-grid">
                        <div class="admin-modal-info-field">
                            <span class="admin-modal-info-field__label">Full Name</span>
                            <span class="admin-modal-info-field__value" id="rapp-fullname">—</span>
                        </div>
                        <div class="admin-modal-info-field">
                            <span class="admin-modal-info-field__label">Contact</span>
                            <span class="admin-modal-info-field__value" id="rapp-phone">—</span>
                        </div>
                        <div class="admin-modal-info-field">
                            <span class="admin-modal-info-field__label">GCash Number</span>
                            <span class="admin-modal-info-field__value" id="rapp-gcash">—</span>
                        </div>
                        <div class="admin-modal-info-field">
                            <span class="admin-modal-info-field__label">Plate Number</span>
                            <span class="admin-modal-info-field__value" id="rapp-plate">—</span>
                        </div>
                        <div class="admin-modal-info-field admin-modal-info-field--full">
                            <span class="admin-modal-info-field__label">Email</span>
                            <span class="admin-modal-info-field__value" id="rapp-email">—</span>
                        </div>
                        <div class="admin-modal-info-field admin-modal-info-field--full">
                            <span class="admin-modal-info-field__label">Address</span>
                            <span class="admin-modal-info-field__value" id="rapp-address">—</span>
                        </div>
                    </div>
                </div>

                <!-- Right: Submitted Requirements -->
                <div class="admin-modal-section">
                    <h3 class="admin-modal-section__title">
                        <i class="ph ph-files admin-modal-section__icon"></i>
                        Submitted Requirements
                    </h3>
                    <div class="admin-modal-doc-list">

                        <div class="admin-modal-doc admin-modal-doc--redesigned">
                            <div class="admin-modal-doc__top">
                                <span class="admin-modal-doc__name">Professional Driver's License</span>
                                <button class="admin-modal-doc__preview-btn" onclick="openAppDoc('license')">
                                    <i class="ph ph-eye"></i>
                                </button>
                            </div>
                            <div class="admin-modal-toggle-group" data-doc="license">
                                <button class="admin-modal-toggle-btn admin-modal-toggle-btn--approve" data-status="Approved" onclick="toggleDocStatus(this)">
                                    <i class="ph ph-check-circle"></i> Approve
                                </button>
                                <button class="admin-modal-toggle-btn admin-modal-toggle-btn--neutral active" data-status="Pending" onclick="toggleDocStatus(this)">
                                    <i class="ph ph-minus-circle"></i> Pending
                                </button>
                                <button class="admin-modal-toggle-btn admin-modal-toggle-btn--reject" data-status="Rejected" onclick="toggleDocStatus(this)">
                                    <i class="ph ph-x-circle"></i> Reject
                                </button>
                            </div>
                        </div>

                        <div class="admin-modal-doc admin-modal-doc--redesigned">
                            <div class="admin-modal-doc__top">
                                <span class="admin-modal-doc__name">Secondary Government ID</span>
                                <button class="admin-modal-doc__preview-btn" onclick="openAppDoc('id')">
                                    <i class="ph ph-eye"></i>
                                </button>
                            </div>
                            <div class="admin-modal-toggle-group" data-doc="id">
                                <button class="admin-modal-toggle-btn admin-modal-toggle-btn--approve" data-status="Approved" onclick="toggleDocStatus(this)">
                                    <i class="ph ph-check-circle"></i> Approve
                                </button>
                                <button class="admin-modal-toggle-btn admin-modal-toggle-btn--neutral active" data-status="Pending" onclick="toggleDocStatus(this)">
                                    <i class="ph ph-minus-circle"></i> Pending
                                </button>
                                <button class="admin-modal-toggle-btn admin-modal-toggle-btn--reject" data-status="Rejected" onclick="toggleDocStatus(this)">
                                    <i class="ph ph-x-circle"></i> Reject
                                </button>
                            </div>
                        </div>

                        <div class="admin-modal-doc admin-modal-doc--redesigned">
                            <div class="admin-modal-doc__top">
                                <span class="admin-modal-doc__name">OR / CR of Motorcycle</span>
                                <button class="admin-modal-doc__preview-btn" onclick="openAppDoc('orcr')">
                                    <i class="ph ph-eye"></i>
                                </button>
                            </div>
                            <div class="admin-modal-toggle-group" data-doc="orcr">
                                <button class="admin-modal-toggle-btn admin-modal-toggle-btn--approve" data-status="Approved" onclick="toggleDocStatus(this)">
                                    <i class="ph ph-check-circle"></i> Approve
                                </button>
                                <button class="admin-modal-toggle-btn admin-modal-toggle-btn--neutral active" data-status="Pending" onclick="toggleDocStatus(this)">
                                    <i class="ph ph-minus-circle"></i> Pending
                                </button>
                                <button class="admin-modal-toggle-btn admin-modal-toggle-btn--reject" data-status="Rejected" onclick="toggleDocStatus(this)">
                                    <i class="ph ph-x-circle"></i> Reject
                                </button>
                            </div>
                        </div>

                        <div class="admin-modal-doc admin-modal-doc--redesigned">
                            <div class="admin-modal-doc__top">
                                <span class="admin-modal-doc__name">Vehicle Photo (Front)</span>
                                <button class="admin-modal-doc__preview-btn" onclick="openAppDoc('front')">
                                    <i class="ph ph-eye"></i>
                                </button>
                            </div>
                            <div class="admin-modal-toggle-group" data-doc="front">
                                <button class="admin-modal-toggle-btn admin-modal-toggle-btn--approve" data-status="Approved" onclick="toggleDocStatus(this)">
                                    <i class="ph ph-check-circle"></i> Approve
                                </button>
                                <button class="admin-modal-toggle-btn admin-modal-toggle-btn--neutral active" data-status="Pending" onclick="toggleDocStatus(this)">
                                    <i class="ph ph-minus-circle"></i> Pending
                                </button>
                                <button class="admin-modal-toggle-btn admin-modal-toggle-btn--reject" data-status="Rejected" onclick="toggleDocStatus(this)">
                                    <i class="ph ph-x-circle"></i> Reject
                                </button>
                            </div>
                        </div>

                        <div class="admin-modal-doc admin-modal-doc--redesigned">
                            <div class="admin-modal-doc__top">
                                <span class="admin-modal-doc__name">Vehicle Photo (Side)</span>
                                <button class="admin-modal-doc__preview-btn" onclick="openAppDoc('side')">
                                    <i class="ph ph-eye"></i>
                                </button>
                            </div>
                            <div class="admin-modal-toggle-group" data-doc="side">
                                <button class="admin-modal-toggle-btn admin-modal-toggle-btn--approve" data-status="Approved" onclick="toggleDocStatus(this)">
                                    <i class="ph ph-check-circle"></i> Approve
                                </button>
                                <button class="admin-modal-toggle-btn admin-modal-toggle-btn--neutral active" data-status="Pending" onclick="toggleDocStatus(this)">
                                    <i class="ph ph-minus-circle"></i> Pending
                                </button>
                                <button class="admin-modal-toggle-btn admin-modal-toggle-btn--reject" data-status="Rejected" onclick="toggleDocStatus(this)">
                                    <i class="ph ph-x-circle"></i> Reject
                                </button>
                            </div>
                        </div>

                        <div class="admin-modal-doc admin-modal-doc--redesigned">
                            <div class="admin-modal-doc__top">
                                <span class="admin-modal-doc__name">Agreement</span>
                                <button class="admin-modal-doc__preview-btn" onclick="openAppDoc('agreement')">
                                    <i class="ph ph-eye"></i>
                                </button>
                            </div>
                            <div class="admin-modal-toggle-group" data-doc="agreement">
                                <button class="admin-modal-toggle-btn admin-modal-toggle-btn--approve" data-status="Approved" onclick="toggleDocStatus(this)">
                                    <i class="ph ph-check-circle"></i> Approve
                                </button>
                                <button class="admin-modal-toggle-btn admin-modal-toggle-btn--neutral active" data-status="Pending" onclick="toggleDocStatus(this)">
                                    <i class="ph ph-minus-circle"></i> Pending
                                </button>
                                <button class="admin-modal-toggle-btn admin-modal-toggle-btn--reject" data-status="Rejected" onclick="toggleDocStatus(this)">
                                    <i class="ph ph-x-circle"></i> Reject
                                </button>
                            </div>
                        </div>

                    </div>
                </div>

            </div><!-- /.appmod-body -->

            <!-- ══ DECISION BAR ══ -->
            <div class="appmod-decision" id="rapp-decision-bar">
                <div class="appmod-decision__textarea-wrap">
                    <span class="admin-modal-info-label">
                        Notes for Applicant
                        <span class="admin-modal-info-label__hint">
                            (optional — shown to applicant)
                        </span>
                    </span>
                    <textarea class="admin-modal-textarea"
                              placeholder="e.g. OR/CR photo is blurry, please resubmit a clearer copy..."></textarea>
                </div>
                <div class="appmod-decision__actions">
                    <button class="admin-modal-btn admin-modal-btn--ghost"
                            onclick="closeModal('rider-application-modal')">
                        Cancel
                    </button>
                    <form id="rapp-reject-form" asp-controller="Admin" asp-action="RejectRider" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" id="rapp-reject-id" />
                        <button type="submit" class="admin-modal-btn admin-modal-btn--reject">
                            <i class="ph ph-x-circle"></i> Reject
                        </button>
                    </form>
                    <form id="rapp-approve-form" asp-controller="Admin" asp-action="ApproveRider" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" id="rapp-approve-id" />
                        <button type="submit" class="admin-modal-btn admin-modal-btn--approve" id="rapp-accept-btn" disabled style="opacity:0.4;cursor:not-allowed;">
                            <i class="ph ph-check-circle"></i> Accept Application
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    var _appDocPaths = {};
    var _currentAppRiderId = 0;

    function viewRiderApplication(riderId) {
        _currentAppRiderId = riderId;
        fetch('/Admin/GetRiderJson?id=' + riderId)
            .then(function (res) { return res.json(); })
            .then(function (r) {
                // Hero
                document.getElementById('rapp-hero-name').textContent = r.fullName;
                document.getElementById('rapp-hero-id').textContent = 'APP-' + String(r.id).padStart(3, '0');
                document.getElementById('rapp-applied-date').textContent = 'Applied ' + r.createdAt;

                // Status badge
                var isPending = r.status === 'Pending';
                var isApproved = r.status === 'Active';
                var badgeClass = isPending ? 'admin-badge--pending' :
                                 isApproved ? 'admin-badge--active' : 'admin-badge--rejected';
                var badgeLabel = isPending ? 'Pending Review' :
                                 isApproved ? 'Approved' : 'Rejected';
                var badge = document.getElementById('rapp-hero-badge');
                badge.className = 'admin-badge ' + badgeClass;
                document.getElementById('rapp-hero-status').textContent = badgeLabel;

                // Applicant info
                document.getElementById('rapp-fullname').textContent = r.fullName;
                document.getElementById('rapp-phone').textContent = r.phone || '—';
                document.getElementById('rapp-gcash').textContent = r.gcContact || '—';
                document.getElementById('rapp-plate').textContent = r.plateNumber || '—';
                document.getElementById('rapp-email').textContent = r.email || '—';
                document.getElementById('rapp-address').textContent = r.address || '—';

                // Document paths
                _appDocPaths = {
                    license: r.licensePath,
                    id: r.idPath,
                    orcr: r.orcrPath,
                    front: r.frontVehiclePath,
                    side: r.sideVehiclePath,
                    agreement: r.agreementPath
                };

                // Decision bar & doc toggles — show only for pending
                var decisionBar = document.getElementById('rapp-decision-bar');
                var docToggles = document.querySelectorAll('#rider-application-modal .admin-modal-toggle-group');
                if (isPending) {
                    decisionBar.style.display = '';
                    document.getElementById('rapp-approve-id').value = r.id;
                    document.getElementById('rapp-reject-id').value = r.id;
                    docToggles.forEach(function (el) {
                        el.style.display = '';
                    });

                    // Restore saved document statuses from database
                    var docStatuses = {
                        license: r.licenseStatus,
                        id: r.idStatus,
                        orcr: r.orcrStatus,
                        agreement: r.agreementStatus,
                        front: r.frontVehicleStatus,
                        side: r.sideVehicleStatus
                    };
                    docToggles.forEach(function (group) {
                        var docType = group.getAttribute('data-doc');
                        var savedStatus = docStatuses[docType] || 'Pending';
                        group.querySelectorAll('.admin-modal-toggle-btn').forEach(function (b) {
                            b.classList.remove('active');
                            if (b.getAttribute('data-status') === savedStatus) {
                                b.classList.add('active');
                            }
                        });
                    });

                    updateAcceptButton();
                } else {
                    decisionBar.style.display = 'none';
                    docToggles.forEach(function (el) { el.style.display = 'none'; });
                }

                openModal('rider-application-modal');
            });
    }

    function openAppDoc(docType) {
        var path = _appDocPaths[docType];
        if (path) {
            var labels = {
                license: "Driver's License",
                id: "Government ID",
                orcr: "OR/CR of Motorcycle",
                front: "Vehicle Photo (Front)",
                side: "Vehicle Photo (Side)",
                agreement: "Agreement"
            };
            previewDocument('rider', path, labels[docType] || 'Document');
        }
    }

    function toggleDocStatus(btn) {
        // Remove active from all siblings in the same toggle group
        var group = btn.closest('.admin-modal-toggle-group');
        group.querySelectorAll('.admin-modal-toggle-btn').forEach(function (b) {
            b.classList.remove('active');
        });
        btn.classList.add('active');

        // Save to database
        var docType = group.getAttribute('data-doc');
        var status = btn.getAttribute('data-status');
        var token = document.querySelector('#rapp-approve-form input[name="__RequestVerificationToken"]').value;

        fetch('/Admin/UpdateDocStatus', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'id=' + _currentAppRiderId + '&docType=' + docType + '&status=' + status + '&__RequestVerificationToken=' + encodeURIComponent(token)
        });

        updateAcceptButton();
    }

    function updateAcceptButton() {
        var acceptBtn = document.getElementById('rapp-accept-btn');
        if (!acceptBtn) return;
        var allGroups = document.querySelectorAll('#rider-application-modal .admin-modal-toggle-group');
        var allApproved = true;
        allGroups.forEach(function (group) {
            // Check if the display is not hidden (only count visible groups)
            if (group.style.display !== 'none') {
                var activeBtn = group.querySelector('.admin-modal-toggle-btn.active');
                if (!activeBtn || !activeBtn.classList.contains('admin-modal-toggle-btn--approve')) {
                    allApproved = false;
                }
            }
        });
        if (allApproved) {
            acceptBtn.disabled = false;
            acceptBtn.style.opacity = '1';
            acceptBtn.style.cursor = 'pointer';
        } else {
            acceptBtn.disabled = true;
            acceptBtn.style.opacity = '0.4';
            acceptBtn.style.cursor = 'not-allowed';
        }
    }
</script>
