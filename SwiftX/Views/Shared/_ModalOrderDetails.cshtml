@*
    Order detail modal — scaffolding for future integration.
    Element ids are placeholders to be populated once the ordering flow is wired
    (e.g. via a GetOrderJson endpoint + JS, mirroring the rider/merchant modals).
    Write-actions are disabled until their backend logic exists.
*@
@{
}
<!-- ── Order Detail Modal ── -->
<div class="admin-modal-overlay" id="order-detail-modal"
     onclick="if(event.target===this)closeModal('order-detail-modal')">
    <div class="admin-modal admin-modal--lg">

        <div class="admin-modal__scroll">

            <!-- ── Hero ── -->
            <div class="omod-hero">
                <div class="omod-hero__left">
                    <p class="omod-hero__label">Order ID</p>
                    <p class="omod-hero__id" id="omod-order-id">—</p>
                    <div class="omod-hero__chips">
                        <span class="admin-badge" id="omod-status">
                            <span class="admin-badge-dot"></span><span id="omod-status-text">—</span>
                        </span>
                        <span class="rmod-hero__chip">
                            <i class="ph ph-calendar-blank"></i> <span id="omod-date">—</span>
                        </span>
                    </div>
                </div>
                <button class="admin-modal__close" onclick="closeModal('order-detail-modal')">
                    <i class="ph ph-x"></i>
                </button>
            </div>

            <!-- ── 2-col body ── -->
            <div class="omod-body">

                <!-- LEFT: People involved -->
                <div class="omod-col">

                    <div class="admin-modal-section">
                        <p class="admin-modal-section__label">Customer</p>
                        <div class="omod-party">
                            <div class="omod-party__av omod-party__av--customer">
                                <i class="ph ph-user"></i>
                            </div>
                            <div>
                                <p class="omod-party__name" id="omod-customer-name">—</p>
                                <p class="omod-party__sub">
                                    <i class="ph ph-phone"></i> <span id="omod-customer-phone">—</span>
                                </p>
                                <p class="omod-party__sub">
                                    <i class="ph ph-map-pin"></i> <span id="omod-customer-address">—</span>
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="admin-modal-section">
                        <p class="admin-modal-section__label">Rider</p>
                        <div class="omod-party">
                            <div class="omod-party__av omod-party__av--rider">
                                <i class="ph ph-motorcycle"></i>
                            </div>
                            <div>
                                <p class="omod-party__name" id="omod-rider-name">—</p>
                                <p class="omod-party__sub">
                                    <i class="ph ph-phone"></i> <span id="omod-rider-phone">—</span>
                                </p>
                                <p class="omod-party__sub">
                                    <i class="ph ph-tag"></i> <span id="omod-rider-plate">—</span>
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="admin-modal-section">
                        <p class="admin-modal-section__label">Merchant</p>
                        <div class="omod-party">
                            <div class="omod-party__av omod-party__av--merchant">
                                <i class="ph ph-storefront"></i>
                            </div>
                            <div>
                                <p class="omod-party__name" id="omod-merchant-name">—</p>
                                <p class="omod-party__sub">
                                    <i class="ph ph-phone"></i> <span id="omod-merchant-phone">—</span>
                                </p>
                                <p class="omod-party__sub">
                                    <i class="ph ph-map-pin"></i> <span id="omod-merchant-address">—</span>
                                </p>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- RIGHT: Items + Breakdown -->
                <div class="omod-col">

                    <div class="admin-modal-section">
                        <p class="admin-modal-section__label">Order Items</p>
                        <div class="omod-items" id="omod-items">
                            <p class="omod-item__name" style="opacity:.4;">No items to display.</p>
                        </div>
                    </div>

                    <div class="admin-modal-section">
                        <p class="admin-modal-section__label">Price Breakdown</p>
                        <div class="omod-breakdown">
                            <div class="omod-breakdown__row">
                                <span>Subtotal</span>
                                <span id="omod-subtotal">—</span>
                            </div>
                            <div class="omod-breakdown__row">
                                <span>Delivery Fee</span>
                                <span id="omod-delivery-fee">—</span>
                            </div>
                            <div class="omod-breakdown__row">
                                <span>Discount</span>
                                <span class="omod-breakdown__discount" id="omod-discount">—</span>
                            </div>
                            <div class="omod-breakdown__divider"></div>
                            <div class="omod-breakdown__row omod-breakdown__row--total">
                                <span>Total</span>
                                <span id="omod-total">—</span>
                            </div>
                            <div class="omod-breakdown__row omod-breakdown__payment">
                                <span class="omod-breakdown__payment-label">Payment Method</span>
                                <span class="omod-breakdown__payment-value" id="omod-payment">—</span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div><!-- /.admin-modal__scroll -->
        <!-- ── Footer ── -->
        <div class="omod-footer">
            <p class="omod-footer__note">
                <i class="ph ph-info"></i>
                Order actions are coming soon — these controls are disabled until the ordering flow is integrated.
            </p>
            <div class="omod-footer__actions">
                <button class="admin-modal-btn admin-modal-btn--ghost"
                        onclick="closeModal('order-detail-modal')">
                    Close
                </button>
                <button class="admin-modal-btn admin-modal-btn--warning" disabled title="Coming soon">
                    <i class="ph ph-arrow-counter-clockwise"></i> Reassign Rider
                </button>
                <button class="admin-modal-btn admin-modal-btn--danger" disabled title="Coming soon">
                    <i class="ph ph-flag"></i> Report Issue
                </button>
                <button class="admin-modal-btn admin-modal-btn--danger-outline" disabled title="Coming soon">
                    <i class="ph ph-x-circle"></i> Cancel Order
                </button>
                <button class="admin-modal-btn admin-modal-btn--success" disabled title="Coming soon">
                    <i class="ph ph-check-circle"></i> Mark as Delivered
                </button>
            </div>
        </div>

    </div>
</div>
