<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>2cab40ac-2c88-4ec0-8084-1efd23d6a597</UserSecretsId>
  </PropertyGroup>

	<!-- One-shot CSS build. Do not use the tailwind watch flag here: a watch never
	     returns and hangs dotnet build / publish / ef. For live rebuilding during dev,
	     run the tailwind watcher in a separate terminal. Skip with -p:BuildCss=false.
	     Two targets handle Windows (npx.cmd) vs Linux/macOS (npx). -->
	<Target Name="BuildCss" BeforeTargets="Compile" Condition="'$(BuildCss)' != 'false' AND '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' == 'true'">
		<Exec Command="npx.cmd tailwindcss -i ./wwwroot/css/site.css -o ./wwwroot/output.css --minify" />
	</Target>
	<Target Name="BuildCssLinux" BeforeTargets="Compile" Condition="'$(BuildCss)' != 'false' AND '$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))' != 'true'">
		<Exec Command="npx tailwindcss -i ./wwwroot/css/site.css -o ./wwwroot/output.css --minify" />
	</Target>

	<ItemGroup>
	  <Content Remove="wwwroot\favicon.ico" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="wwwroot\Assets\fonts\GT-America-Standard-Thin.otf" />
	  <None Include="wwwroot\Assets\fonts\GT-America.otf" />
	  <None Include="wwwroot\Assets\fonts\Sora-Regular.ttf" />
	  <None Include="wwwroot\Assets\fonts\SuisseIntl-Light.ttf" />
	  <None Include="wwwroot\Assets\fonts\SuisseIntl-Regular.ttf" />
	  <None Include="wwwroot\Assets\images\rider_illustration_vector.png" />
	  <None Include="wwwroot\Assets\images\swiftX_logo.png" />
	  <None Include="wwwroot\favicon.ico" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.0">
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	    <PrivateAssets>all</PrivateAssets>
	  </PackageReference>
	  <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="8.0.0" />
	  <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.0" />
	</ItemGroup>

</Project>
